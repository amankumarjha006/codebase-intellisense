    {
      "name": "RAG Query Validation API",
      "item": [
        {
          "name": "POST RAG Query (Empty query)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "session_id={{session_cookie_1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repositories/{{repository_id}}/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "repositories",
                "{{repository_id}}",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"\", \"repository_version_id\": \"{{repository_version_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 or 422', function () { pm.expect(pm.response.code).to.be.oneOf([400, 422]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST RAG Query (Unauthorized Repo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "session_id={{session_cookie_2}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repositories/{{repository_id}}/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "repositories",
                "{{repository_id}}",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"test\", \"repository_version_id\": \"{{repository_version_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
