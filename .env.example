# =========================
# Infrastructure
# =========================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/codebase_intellisense
REDIS_URL=redis://localhost:6379/0


# =========================
# Application
# =========================

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000/dashboard


# =========================
# GitHub App Authentication
# =========================

GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=your_generated_fernet_key


# =========================
# Session
# =========================

SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_SECONDS=86400


# =========================
# AI
# =========================

# -------------------------
# Gemini API
# -------------------------

GEMINI_API_KEY=your_gemini_api_key


# -------------------------
# Embeddings
# -------------------------

# Embeddings
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# LLM Provider Chain
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=openrouter

# Gemini LLM models
GEMINI_LLM_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_LLM_MODEL_FALLBACK_1=gemini-3.7-flash
GEMINI_LLM_MODEL_FALLBACK_2=gemini-3.6-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=openrouter/free