# ==============================================================================
# Codebase Intelligence - Production Environment Template
# ==============================================================================
# Usage:
#   1. Copy this file to .env (or provide these variables to your deployment harness).
#   2. Replace all placeholder values with production credentials.
#   3. NEVER commit real secrets or production .env files to source control.
# ==============================================================================

# ==========================================
# Core Application Environment
# ==========================================
ENVIRONMENT=production
ENABLE_DEV_LOGIN=false
ENABLE_API_DOCS=false

# ==========================================
# URLs & CORS Security (HTTPS Strictly Enforced)
# ==========================================
# Must use https:// in production. CORS_ORIGINS must NOT contain localhost or 127.0.0.1.
FRONTEND_URL=https://codebase.yourdomain.com/dashboard
CORS_ORIGINS=https://codebase.yourdomain.com
VITE_API_URL=https://api.codebase.yourdomain.com

# ==========================================
# GitHub OAuth App Credentials
# ==========================================
# Create a production GitHub OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_CALLBACK_URL=https://api.codebase.yourdomain.com/api/v1/auth/github/callback

# Token Encryption Key: 32-byte base64-encoded key used to encrypt user GitHub access tokens at rest.
# Generate via:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=generate_with_fernet_and_paste_here

# ==========================================
# Session & Cookie Security
# ==========================================
SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_SECONDS=86400
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE defaults to true when ENVIRONMENT=production
SESSION_COOKIE_SECURE=true

# ==========================================
# Database & Cache Credentials
# ==========================================
# Strong random passwords for PostgreSQL and Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_postgres_password_here
POSTGRES_DB=codebase_intellisense

REDIS_PASSWORD=generate_strong_redis_password_here

# Database connection URL (for Docker compose or standalone deployment)
# In Docker compose prod: host is "postgres:5432" and "redis:6379"
DATABASE_URL=postgresql+psycopg://postgres:generate_strong_postgres_password_here@postgres:5432/codebase_intellisense
REDIS_URL=redis://:generate_strong_redis_password_here@redis:6379/0

# ==========================================
# AI & Embedding Providers
# ==========================================
# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_production_gemini_api_key

# Embedding Configuration (Calibrated for Google Gemini embedding models)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_BATCH_ITEMS=32
EMBEDDING_MAX_BATCH_TOKENS=8500
EMBEDDING_MIN_INTERVAL_SECONDS=2.0
EMBEDDING_TARGET_TPM=24000
EMBEDDING_MAX_RETRIES=5
EMBEDDING_CHARS_PER_TOKEN=3

# Indexing Limits
MAX_INDEXABLE_FILE_SIZE_BYTES=200000
INDEXING_MAX_ESTIMATED_TOKENS=3000000
INDEXING_DATA_FILE_MAX_BYTES=50000

# LLM Providers & Fallback Chain
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=openrouter

GEMINI_LLM_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_LLM_MODEL_FALLBACK_1=gemini-3.8-flash

# Optional OpenRouter fallback API Key
OPENROUTER_API_KEY=your_production_openrouter_api_key
OPENROUTER_FALLBACK_MODEL=openrouter/free

# ==========================================
# Observability & Rate Limiting
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_REQUESTS=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_RAG_REQUESTS=20
RATE_LIMIT_RAG_WINDOW_SECONDS=60
RATE_LIMIT_STREAM_REQUESTS=10
RATE_LIMIT_STREAM_WINDOW_SECONDS=60
